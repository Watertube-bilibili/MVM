{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "electron"
    ],
    "rootDir": "electron",
    "outDir": "dist-electron",
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": [
    "electron/**/*.ts"
  ]
}
