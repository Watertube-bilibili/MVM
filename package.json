{
  "name": "mvm",
  "version": "0.1.0",
  "private": true,
  "author": "MVM Project",
  "description": "MVM desktop shell for macOS application compatibility experiments on Windows.",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run build:electron && concurrently --kill-others-on-fail --names renderer,electron \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "npm run typecheck:electron && npm run typecheck:renderer && npm run typecheck:vite",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:vite": "tsc -p tsconfig.vite.json --noEmit",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "plist": "5.0.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.5",
    "@fluentui/react-icons": "2.0.335",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/node": "26.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "io.mvm.desktop",
    "productName": "MVM",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MVM"
    }
  }
}
